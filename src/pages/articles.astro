---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css'

import { posts } from './content.ts';

const sorted = [...posts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const years = [...new Set(sorted.map(p => new Date(p.date).getFullYear()))].sort((a, b) => a - b);
---

<html lang="fr">
	<body>
		<Header />
		<main>
			<h2>Mes posts</h2>
			<div class="filters">
				<button class="filter-btn active" data-year="all">Tous</button>
				{years.map(year => (
					<button class="filter-btn" data-year={year}>{year}</button>
				))}
			</div>

			<div class="posts">
				{sorted.map((post) => (
					<div class="post" data-year={new Date(post.date).getFullYear()}>
						<h3>{post.date}</h3>
						<p>{post.text}</p>
						<div class="line"></div>
					</div>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const posts = document.querySelectorAll<HTMLElement>('.post');

	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			buttons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			const year = btn.dataset.year;

			posts.forEach(post => {
				post.style.display = (year === 'all' || post.dataset.year === year) ? 'block' : 'none';
			});
		});
	});
</script>